        "src/chess_lab/scripts/worker/instalar.sh"
      ],
      "cmd": "bash src/chess_lab/scripts/worker/instalar.sh",
      "fetch": []
    },
    "reunir": {
      "sync": [
        "src/chess_lab/scripts/worker/reunir.sh"
      ],
      "cmd": "bash src/chess_lab/scripts/worker/reunir.sh",
      "fetch": [
        "data/results/roundrobin/"
      ]
    },
    "arrancar": {
      "sync": [
        "src/chess_lab/scripts/worker/arrancar.sh"
      ],
      "cmd": "bash src/chess_lab/scripts/worker/arrancar.sh",
      "fetch": []
    },
    "parar": {
      "sync": [
        "src/chess_lab/scripts/worker/parar.sh"
      ],
      "cmd": "bash src/chess_lab/scripts/worker/parar.sh",
      "fetch": []
    }
  }
}
