{
  "tareas": {
    "subir": {
      "sync": [
        "rust/target/release/uci",
        "data/results/uci_models/",
        "data/openings/openings.epd",
        "src/chess_lab/scripts/worker/roundrobin.py",
        "src/chess_lab/scripts/worker/queue.json",
        "src/chess_lab/scripts/worker/instalar.sh"
      ],
      "cmd": "bash src/chess_lab/scripts/worker/instalar.sh",
      "fetch": []
    },
    "reunir": {
      "sync": [
        "src/chess_lab/scripts/worker/reunir.sh"
      ],
      "cmd": "bash src/chess_lab/scripts/worker/reunir.sh",
      "fetch": [
        "data/results/roundrobin/"
      ]
    },
    "arrancar": {
      "sync": [
        "src/chess_lab/scripts/worker/arrancar.sh"
      ],
      "cmd": "bash src/chess_lab/scripts/worker/arrancar.sh",
      "fetch": []
    },
    "parar": {
      "sync": [
        "src/chess_lab/scripts/worker/parar.sh"
      ],
      "cmd": "bash src/chess_lab/scripts/worker/parar.sh",
      "fetch": []
    },
    "entrenar": {
      "sync": [
        "src/chess_engine/",
        "src/chess_lab/",
        "pyproject.toml",
        "README.md",
        "rust/src/",
        "rust/models/",
        "rust/Cargo.toml",
        "rust/Cargo.lock",
        "data/LichessPositions/raw/",
        "data/LichessPositions/sidecar/"
      ],
      "cmd": "bash src/chess_lab/scripts/worker/entrenar.sh",
      "fetch": [
        "data/results/entrenar/"
      ]
    },
    "entrenar-prueba": {
      "sync": [
        "src/chess_engine/",
        "src/chess_lab/",
        "pyproject.toml",
        "README.md",
        "rust/src/",
        "rust/models/",
        "rust/Cargo.toml",
        "rust/Cargo.lock",
        "data/LichessPositions/raw/",
        "data/LichessPositions/sidecar/"
      ],
      "cmd": "bash src/chess_lab/scripts/worker/entrenar.sh prueba",
      "fetch": [
        "data/results/entrenar/"
      ]
    }
  }
}
